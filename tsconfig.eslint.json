{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": ".",
        "noEmit": true
    },
    "include": ["src/**/*.ts", "test/src/**/*.ts"],
    "exclude": ["node_modules", "build"]
}
